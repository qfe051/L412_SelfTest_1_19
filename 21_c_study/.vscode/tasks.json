{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build (clang)",
      "type": "shell",
      "command": "clang",
      "args": [
        "-std=c11",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-O0",
        "-g",
        "src/main.c",
        "-o",
        "build/app"
      ],
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "run",
      "type": "shell",
      "command": "./build/app",
      "dependsOn": "build (clang)"
    }
  ]
}