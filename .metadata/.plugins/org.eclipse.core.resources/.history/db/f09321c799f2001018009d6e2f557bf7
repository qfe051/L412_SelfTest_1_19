// 8x8 출력 버퍼 생성  
static uint8_t buf_8[8][8];

// 배열에서 사용성 향상 위한 함수 선언

static inline void row_off(uint8_t r){
  HAL_GPIO_WritePin(ROW_PORT[r],ROW_PIN[r],GPIO_PIN_RESET);
}

static inline void row_on(uint8_t r){
  HAL_GPIO_WritePin(ROW_PORT[r],ROW_PIN[r],GPIO_PIN_SET);
}

static inline void col_on(uint8_t c){
  HAL_GPIO_WritePin(COL_PORT[c],COL_PIN[c],GPIO_PIN_RESET);
}

static inline void col_off(uint8_t c){
  HAL_GPIO_WritePin(COL_PORT[c],COL_PIN[c],GPIO_PIN_SET);
}

// 전체 종료 
static inline void matrix_all_off(void){
  // col -> set
  for (int c=0; c<8 ; c++){
    col_off(c);
  }
  // row -> reset
  for (int r=0; r<8 ; r++){
    row_off(r);
  }
}

// 버퍼 동작 관련 선언

// 버퍼 clear 
static void buf_clear(void){
  for (int x=0 ; x<8 ; x++){
    for (int y=0 ; y<8 ; y++){
      buf_8[x][y] = 0 ;
    }
  }
} 


// c r 순서대로 해보기 
static void x_to_buf_8(int a, int b){
  for (int r=0; r<3; r++){

    for (int c=0; c<3; c++){
      int raw_c = a + c; // 실제 x 연산 해주는 값 
      int bc = raw_c % 8 ; // 0~7 찍혀야하는 좌표
      int carry = raw_c / 8; // int 사용하여 몫이 1 or 0으로 출력 

      int raw_r = b + r + carry; // carry값 유무를 통해 1칸 단위로 움직이도록
      int br = raw_r % 8;

        buf_8[bc][br] = img_x[c][r];


    }
  }
}

// 한 프레임 생성
// row_hold_ms - 다음 함수에서 대입 예정
// c r 순서로 업데이트 확인 
static void draw_buf_8_frame(uint16_t row_hold_ms){
  for(int r=0; r<8; r++){
    // 전체 off
    //matrix_all_off();

    // row에서 col 설정
    for (int c=0; c<8; c++){
      if(buf_8[c][r]==1){
        col_on(c);
      }
      else{
        col_off(c);
      }
    }
    // row 하나 단위로 c 켤 것들 다 켜기 
    row_on(r);

    // 유지시간 -> 사람 눈에 안띌 정도 , 1~2ms 까지 줄여보기
    HAL_Delay(row_hold_ms);
  }
}

// 눈에 보이도록 '
static void show_for_ms(uint32_t total_ms, uint16_t row_hold_ms){
  // row = 8 
  uint32_t frame_time = 8 * row_hold_ms;
  if (frame_time == 0){
    frame_time = 1 ; 
  }

  uint32_t frames = total_ms / frame_time;
  if (frames == 0){
    frames = 1 ; 
  }
  for (uint32_t i=0; i<frames; i++){
    draw_buf_8_frame(row_hold_ms);
  }

}

